{
	"name": "nicogill/wp-eclipse",
	"description": "WordPress development starter hybrid theme by (and mostly for) Nicolas Gillium.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Nicolas Gillium",
			"email": "contact@nicolas-gillium.fr"
		}
	],
	"config": {
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"squizlabs/php_codesniffer": true,
			"wp-coding-standards/wpcs": true
		},
		"sort-packages": true
	},
	"require": {
		"php": ">=8.0",
		"composer/installers": "^2.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-cli/i18n-command": "^2.6",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"scripts": {
		"format": "phpcbf --report=summary,source",
		"lint": "phpcs --report=code",
		"report": "phpcs  --report=full,source",
		"pot": "wp i18n make-pot . languages/wp-eclipse.pot --exclude=node_modules,vendor,build",
		"zip": "php bin/package.php"
	}
}
